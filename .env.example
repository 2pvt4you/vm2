# Server
PORT=3000
NODE_ENV=development

# Postgres (Railway provides this automatically when you attach a Postgres plugin)
DATABASE_URL=postgresql://user:password@localhost:5432/varahametaliks
# Set to "false" for local Postgres without SSL
DATABASE_SSL=false

# Frontend (BUILD-TIME — Vite inlines this during `npm run build`)
# Must be available on Railway during the build step, not only at runtime.
# Name must start with VITE_
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
